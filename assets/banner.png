<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="400" viewBox="0 0 1200 400">
  <rect width="1200" height="400" fill="#0f172a"/>
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#38bdf8;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#818cf8;stop-opacity:1" />
    </linearGradient>
  </defs>
  <text x="600" y="180" fill="url(#grad)" font-family="system-ui, sans-serif" font-size="64" font-weight="bold" text-anchor="middle">🚀 Awesome Dev Prompts</text>
  <text x="600" y="240" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="24" text-anchor="middle">Production-Grade AI System Prompts &amp; Developer Workflows</text>
</svg>
